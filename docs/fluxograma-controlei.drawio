1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="leitura" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="escrita" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="dado não confiável" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;dashed=1;strokeColor=#6b7280;fontSize=11;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Resposta final&lt;/b&gt;&lt;br&gt;sanitizada, até 1500 caracteres" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#d1fae5;strokeColor=#047857;fontColor=#064e3b;" vertex="1" parent="c18"><mxGeometry x="20" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="c28" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" edge="1" parent="1" source="c20" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;PendingActions&lt;/b&gt;&lt;br&gt;resumo montado pelo servidor · vale 10 min · uso único · só o dono · máx. 5" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1580" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="c31" value="prepara" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c22" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Cartão no chat&lt;/b&gt;&lt;br&gt;Confirmar / Cancelar (exclusão em vermelho com botão &quot;Excluir&quot;)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1580" y="890" width="280" height="100" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;POST /actions/{id}/confirm&lt;/b&gt;&lt;br&gt;pega a ação do dono (outro usuário recebe 404)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1580" y="1040" width="280" height="100" as="geometry"/></mxCell><mxCell id="c35" value="clique do usuário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Services da API&lt;/b&gt;&lt;br&gt;mesmas regras: família, papel, validação" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1580" y="1190" width="280" height="90" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;AuditLog&lt;/b&gt;&lt;br&gt;registra cada ação confirmada" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="1580" y="1330" width="280" height="70" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c36" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Tela recarrega&lt;/b&gt;&lt;br&gt;o dado novo aparece sem sair do chat" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1180" y="1190" width="280" height="90" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c36" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="Cancelar: descarta a ação" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;" vertex="1" parent="1"><mxGeometry x="1180" y="905" width="280" height="70" as="geometry"/></mxCell><mxCell id="c43" value="cancelar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;dashed=1;strokeColor=#6b7280;fontSize=11;" edge="1" parent="1" source="c32" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Camadas de segurança (não dependem do modelo se comportar)&lt;/b&gt;&lt;br&gt;• Escrita nunca executa sem o clique do usuário: texto malicioso numa descrição não gasta dinheiro.&lt;br&gt;• O modelo cita contas, categorias e metas pelo NOME; o servidor resolve. Sem ids inventados.&lt;br&gt;• Para editar/excluir, o servidor acha o lançamento pela descrição e devolve as opções se for ambíguo.&lt;br&gt;• Histórico aceita só user/assistant (um &quot;system&quot; forjado nunca entra).&lt;br&gt;• Resultado de ferramenta é dado, não instrução." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="420" height="250" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Defesas de confiabilidade&lt;/b&gt;&lt;br&gt;• Se o modelo disser &quot;preparei&quot; sem chamar a ferramenta, o servidor detecta, pede uma nova tentativa e, se insistir, troca por resposta honesta.&lt;br&gt;• Cota diária por família (separada dos comprovantes) e disjuntor após 3 falhas seguidas.&lt;br&gt;• Sem IA, a base de ajuda local responde: o botão nunca fica mudo." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="420" height="190" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Privacidade&lt;/b&gt;&lt;br&gt;Com a IA ligada, perguntas e os dados consultados vão ao provedor. Por isso há um interruptor por família, desligado por padrão: só o responsável liga, depois de aceitar um aviso explícito, e a mudança fica na auditoria." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 · Decisões e porquês" id="60524427"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Decisões de arquitetura e de produto: o que foi escolhido, o que foi descartado e por quê" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Régua: ementas Java + IA e IA Aplicada (UNIPDS). O que a ementa pede e ainda não existe está listado no fim, sem maquiagem." style="html=1;whiteSpace=wrap;text;fontSize=12;align=left;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Decisão" style="html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#064e3b;strokeColor=#064e3b;fontColor=#ffffff;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="330" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Alternativa descartada" style="html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#064e3b;strokeColor=#064e3b;fontColor=#ffffff;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="380" height="36" as="geometry"/></mxCell><mxCell id="c6" value="Por quê" style="html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fillColor=#064e3b;strokeColor=#064e3b;fontColor=#ffffff;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="800" height="36" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Camadas + Clean Architecture, regra verificada por ArchUnit&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="330" height="96" as="geometry"/></mxCell><mxCell id="c8" value="Só convenção de pastas; ou Hexagonal estrito com casos de uso como interfaces" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="136" width="380" height="96" as="geometry"/></mxCell><mxCell id="c9" value="É o que a ementa pede (módulo 4). ArchUnit transforma a regra em teste: uma violação (application importando infrastructure) já havia passado despercebida e foi corrigida e travada." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="136" width="800" height="96" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Transactional Outbox + consumidor idempotente + DLT&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="232" width="330" height="96" as="geometry"/></mxCell><mxCell id="c11" value="Publicar no Kafka direto dentro do service" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="232" width="380" height="96" as="geometry"/></mxCell><mxCell id="c12" value="Gravar no banco e publicar são duas operações: falha parcial perderia ou duplicaria eventos. O evento vai na mesma transação; o Kafka entrega &quot;pelo menos uma vez&quot;, então o consumidor precisa tolerar repetição." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="232" width="800" height="96" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Rodar na mesma VPS do JavAI, com rede e limites próprios&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="328" width="330" height="96" as="geometry"/></mxCell><mxCell id="c14" value="Outra VPS; ou juntar os dois repositórios" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="328" width="380" height="96" as="geometry"/></mxCell><mxCell id="c15" value="Custo e uma só borda segura. Repositórios separados mantêm o histórico e o deploy de cada um; o JavAI não foi afetado (nenhuma porta nova, memória limitada)." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="328" width="800" height="96" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tailscale como caminho padrão de deploy e SSH&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="424" width="330" height="96" as="geometry"/></mxCell><mxCell id="c17" value="SSH aberto na internet com chave" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="424" width="380" height="96" as="geometry"/></mxCell><mxCell id="c18" value="Superfície pública zero: o CI entra na tailnet por OIDC (sem segredo de longa duração) e o SSH só aceita um comando forçado que recebe um SHA." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="424" width="800" height="96" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Assistente de IA como agente com confirmação humana&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="330" height="96" as="geometry"/></mxCell><mxCell id="c20" value="Executar direto o que o modelo decidir" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="520" width="380" height="96" as="geometry"/></mxCell><mxCell id="c21" value="Texto de descrições e comprovantes pode conter instruções (prompt injection) e há ações irreversíveis. O modelo só prepara; o servidor monta o resumo e o usuário confirma. Exclusão tem cartão vermelho." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="520" width="800" height="96" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;O modelo usa nomes; o servidor resolve ids e acha lançamentos&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="616" width="330" height="96" as="geometry"/></mxCell><mxCell id="c23" value="Dar ids ao modelo e deixá-lo filtrar" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="616" width="380" height="96" as="geometry"/></mxCell><mxCell id="c24" value="Nos testes com o modelo real, ele errou contagem e pediu ids ao usuário. Resolver no servidor elimina ids inventados e erro de filtro; ambiguidade volta como pergunta." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="616" width="800" height="96" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Interruptor da IA por família, desligado por padrão, aceite do responsável&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="712" width="330" height="96" as="geometry"/></mxCell><mxCell id="c26" value="IA sempre ligada" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="712" width="380" height="96" as="geometry"/></mxCell><mxCell id="c27" value="Os dados consultados saem para um provedor externo. A decisão é do responsável da família, com aviso claro, registrada na auditoria; sem o aceite nada sai do servidor." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="712" width="800" height="96" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Lançamentos do assistente nascem pagos (pendente só para conta a vencer)&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="808" width="330" height="96" as="geometry"/></mxCell><mxCell id="c29" value="Criar sempre pendente, como a API faz" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="808" width="380" height="96" as="geometry"/></mxCell><mxCell id="c30" value="Achado no teste real: &quot;gastei 87,90&quot; aparecia como R$ 0,00 porque os totais só contam pagos. A intenção do usuário (&quot;gastei&quot;) já é pagamento." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="808" width="800" height="96" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;PWA instalável no lugar de app nativo agora&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="904" width="330" height="96" as="geometry"/></mxCell><mxCell id="c32" value="Começar pelo app Kotlin" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="904" width="380" height="96" as="geometry"/></mxCell><mxCell id="c33" value="Uma base de código, instalável e com a casca offline; a API nunca entra no cache (dados privados). O app Kotlin fica para depois." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="904" width="800" height="96" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Cadastro aberto e Controlei público (Cloudflare Access removido)&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="330" height="96" as="geometry"/></mxCell><mxCell id="c35" value="Manter privado atrás do Access" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1000" width="380" height="96" as="geometry"/></mxCell><mxCell id="c36" value="Decisão do dono: será um projeto público de estudo. Mitigação: rate limit, cotas e bloqueio de login. Pendente: CAPTCHA (Turnstile)." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="1000" width="800" height="96" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Fallback sem IA, cota diária e disjuntor&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="1096" width="330" height="96" as="geometry"/></mxCell><mxCell id="c38" value="Depender sempre do modelo" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1096" width="380" height="96" as="geometry"/></mxCell><mxCell id="c39" value="Custo limitado e disponibilidade: IA desligada, sem cota ou fora do ar cai para a base de ajuda local." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="1096" width="800" height="96" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Postgres com Flyway imutável; H2 só nos testes&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="1192" width="330" height="96" as="geometry"/></mxCell><mxCell id="c41" value="Editar migrações aplicadas; Testcontainers desde o início" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1192" width="380" height="96" as="geometry"/></mxCell><mxCell id="c42" value="Migração aplicada nunca muda (mudança vira uma nova versão). H2 deixa a suíte rápida; Testcontainers entra como evolução." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#f0fdf4;strokeColor=#9ca3af;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="1192" width="800" height="96" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;O que a ementa pede e o Controlei ainda NÃO tem (honestidade técnica)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;DDD tático:&lt;/b&gt; as entidades são anêmicas; falta levar regras (valor positivo, estados válidos, pagar/cancelar) para dentro dos agregados.&lt;br&gt;• &lt;b&gt;CQRS:&lt;/b&gt; leitura e escrita usam os mesmos serviços; um modelo de leitura separado para dashboard e relatórios seria o próximo passo. Event Sourcing: não aplicado.&lt;br&gt;• &lt;b&gt;DDD estratégico:&lt;/b&gt; há um só contexto delimitado, com fronteiras implícitas.&lt;br&gt;• &lt;b&gt;Operação:&lt;/b&gt; backup do Postgres e CAPTCHA no cadastro ainda pendentes; testes com Testcontainers e Kafka real ainda não existem." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="1318" width="1510" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>