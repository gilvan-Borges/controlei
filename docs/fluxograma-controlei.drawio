<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram name="1 · Arquitetura e implantação" id="79753864"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Controlei · arquitetura em camadas (Clean Architecture) e implantação" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Regra de dependência: de fora para dentro. O domínio não conhece Spring, JPA nem infraestrutura. Verificada por ArchUnit no build (CI)." style="html=1;whiteSpace=wrap;text;fontSize=12;align=left;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Usuário&lt;/b&gt;&lt;br&gt;PWA instalável (celular) ou navegador" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="170" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;TLS, WAF, Authenticated Origin Pulls" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="180" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Caddy do JavAI&lt;/b&gt;&lt;br&gt;único a publicar a porta 443 (rota controlei.)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="180" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Gateway nginx&lt;/b&gt;&lt;br&gt;CSP, rate limit por rota, X-Real-IP só da rede de borda" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="670" y="120" width="180" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Front Angular 21&lt;/b&gt;&lt;br&gt;nginx-unprivileged, service worker (PWA), API nunca em cache" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="890" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="c9" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="rede controlei-edge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Back · Spring Boot 4 / Java 25  (container &quot;back&quot;)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;fontStyle=1;startSize=28;strokeWidth=2;fillColor=#f9fafb;strokeColor=#6b7280;fontColor=#111827;collapsible=0;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="560" height="520" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;application.controllers&lt;/b&gt;&lt;br&gt;REST, validação, só falam com services" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="c13"><mxGeometry x="20" y="40" width="520" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;application.services&lt;/b&gt; (casos de uso)&lt;br&gt;Auth · Transações · Orçamentos · Metas · Comprovantes · &lt;b&gt;Assistente de IA&lt;/b&gt; (ferramentas + confirmação)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="c13"><mxGeometry x="20" y="125" width="520" height="86" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;domain&lt;/b&gt; (sem Spring/JPA)&lt;br&gt;models, enums, DTOs · domain.services puros (SplitCalculator, DebtSimplifier) · &lt;b&gt;domain.contracts&lt;/b&gt; = portas (repositórios, IA, eventos)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="c13"><mxGeometry x="20" y="235" width="520" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;infrastructure&lt;/b&gt; = adaptadores das portas&lt;br&gt;JPA + mapper · JDBC (interruptor do assistente) · OpenRouter (comprovantes e assistente) · Outbox + Relay Kafka · segurança JWT" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="c13"><mxGeometry x="20" y="360" width="520" height="120" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill