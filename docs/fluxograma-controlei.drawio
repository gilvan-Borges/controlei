s)" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="1250" y="370" width="190" height="110" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Ignora&lt;br&gt;(idempotente)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;" vertex="1" parent="1"><mxGeometry x="1500" y="395" width="150" height="60" as="geometry"/></mxCell><mxCell id="c22" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;BudgetAlertService&lt;/b&gt;&lt;br&gt;soma o gasto da categoria e compara com o teto" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1020" y="395" width="190" height="70" as="geometry"/></mxCell><mxCell id="c24" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="Passou do limiar de alerta?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="200" height="110" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;cria a notificação para a família" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="520" y="395" width="190" height="70" as="geometry"/></mxCell><mxCell id="c28" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Nada a fazer" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;" vertex="1" parent="1"><mxGeometry x="780" y="540" width="170" height="50" as="geometry"/></mxCell><mxCell id="c30" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Falhou várias vezes?&lt;/b&gt;&lt;br&gt;vai para a DLT (fila de mortos) para análise, sem travar o resto" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="c32" value="erro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;" edge="1" parent="1" source="c23" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Decisões&lt;/b&gt;&lt;br&gt;• Outbox em vez de publicar direto: nunca perde nem duplica por falha parcial.&lt;br&gt;• Ordem por &lt;b&gt;seq&lt;/b&gt; (identity), não por UUID aleatório: eventos saem na ordem em que foram gravados.&lt;br&gt;• Consumidor idempotente: o Kafka entrega &quot;pelo menos uma vez&quot;, então repetir não pode duplicar alerta.&lt;br&gt;• DLT: uma mensagem ruim não bloqueia a fila." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="440" height="170" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Teste&lt;/b&gt;&lt;br&gt;Há teste de integração do relay e do consumidor; a regra de camadas (consumidor fino, lógica no service) está no ArchUnit." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="440" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Fluxo do assistente de IA" id="86876121"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Assistente de IA: lê os dados da família e age por ela, sempre com confirmação humana" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="O modelo só PEDE ferramentas. Quem decide, valida e executa é o servidor, como o usuário logado e pelos mesmos serviços das telas." style="html=1;whiteSpace=wrap;text;fontSize=12;align=left;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Usuário&lt;/b&gt;&lt;br&gt;escreve no chat flutuante" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Widget (Angular)&lt;/b&gt;&lt;br&gt;POST /assistant/ask com pergunta e histórico (só user/assistant)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;20 requisições/min por IP" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Auth JWT&lt;/b&gt;&lt;br&gt;identifica usuário e família" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="670" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;e