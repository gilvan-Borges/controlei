orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c17" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="Outbox Relay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c17" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;OpenRouter&lt;/b&gt;&lt;br&gt;modelo de linguagem&lt;br&gt;data_collection=deny" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#d1fae5;strokeColor=#047857;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="180" height="90" as="geometry"/></mxCell><mxCell id="c29" value="só com IA ligada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;dashed=1;strokeColor=#6b7280;fontSize=11;" edge="1" parent="1" source="c17" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;testes, ArchUnit, Trivy, imagens no GHCR" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="190" height="80" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Tailscale (OIDC)&lt;/b&gt;&lt;br&gt;o CI entra na tailnet" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="240" y="330" width="190" height="80" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;SSH restrito&lt;/b&gt;&lt;br&gt;deploy-controlei: comando forçado aceita só um SHA" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="190" height="80" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;VPS do JavAI&lt;/b&gt;&lt;br&gt;docker compose, redes data(interna)/app/edge" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="460" y="460" width="190" height="80" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="rollback se falhar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Por que na mesma VPS?&lt;/b&gt;&lt;br&gt;Uma só borda segura (Caddy + Cloudflare), custo zero adicional, e o JavAI não é afetado: rede própria, limites de memória e nenhuma porta publicada pelo Controlei." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="400" height="150" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Dados isolados&lt;/b&gt;&lt;br&gt;Postgres, Redis e Kafka ficam numa rede interna, sem rota para a internet. SSH e Kafka UI só pela Tailscale." style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="400" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Fluxo do lançamento (Outbox)" id="92230652"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Do lançamento ao alerta de orçamento: Transactional Outbox + consumidor idempotente" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Problema: gravar no banco e publicar no Kafka são duas operações; se uma falhar, o sistema fica inconsistente (dual write). A solução grava o evento na MESMA transação." style="html=1;whiteSpace=wrap;text;fontSize=12;align=left;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Usuário&lt;/b&gt;&lt;br&gt;lança uma despesa (tela ou assistente)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;valida o corpo e o JWT" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="210" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;TransactionService&lt;/b&gt;&lt;br&gt;autoriza pela família, valida conta e categoria" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="Uma única transação do banco" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;fontStyle=1;startSize=28;strokeWidth=2;fillColor=#f9fafb;strokeColor=#6b7280;fontColor=#111827;collapsible=0;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="330" height="130" as="geometry"/></mxCell><mxCell id="c10" value="INSERT&lt;br&gt;&lt;b&gt;transactions&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;" vertex="1" parent="c9"><mxGeometry x="15" y="40" width="140" height="70" as="geometry"/></mxCell><mxCell id="c11" value="INSERT&lt;br&gt;&lt;b&gt;outbox_events&lt;/b&gt; (seq)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fontSize=12;strokeWidth=2;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;" vertex="1" parent="c9"><mxGeometry x="175" y="40" width="140" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth