# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=controlei
DB_USER=controlei
DB_PASSWORD=controlei123
DB_POOL_SIZE=20

# Cache Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Segurança & JWT (Altere em produção com chave de 256 bits!)
JWT_SECRET=super-secret-production-key-change-this-in-real-prod-controlei-2026
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS & Gateway
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# Porta do Nginx Gateway
GATEWAY_PORT=80
