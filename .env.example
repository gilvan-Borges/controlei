# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=controlei
DB_USER=controlei
# Obrigatoria: o Compose nao sobe sem ela. Gere uma senha propria (openssl rand -base64 24)
DB_PASSWORD=troque-por-uma-senha-forte
DB_POOL_SIZE=20

# Cache Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Segurança & JWT (Altere em produção com chave de 256 bits!)
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS & Gateway
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# Porta do Nginx Gateway
GATEWAY_PORT=80

# IA nos comprovantes (opcional, desligada por padrao: a imagem sai do servidor)
CONTROLEI_AI_ENABLED=false
CONTROLEI_AI_API_KEY=
CONTROLEI_AI_MODEL=google/gemini-2.5-flash

# Webhook do Open Finance: segredo para validar a assinatura HMAC. Vazio = nenhum webhook e aceito.
OPENFINANCE_WEBHOOK_SECRET=

# Cota diaria de leituras de comprovante por IA, por familia
CONTROLEI_AI_DAILY_LIMIT=30

