# /opt/controlei/.env na VPS (chmod 600, dono root). Nunca commitar o arquivo real.
# CONTROLEI_TAG e gravado pelo script de deploy (SHA do commit); no primeiro deploy, preencha a mao.
CONTROLEI_TAG=

# Gere cada segredo com: openssl rand -base64 32
DB_PASSWORD=
REDIS_PASSWORD=
# Minimo de 32 caracteres; em producao os valores de exemplo sao recusados na partida
JWT_SECRET=

DB_NAME=controlei
DB_USER=controlei
PUBLIC_URL=https://controlei.gilvanborges.com.br

# Cadastro de novas familias. Deixe true so ate criar a SUA conta, depois false.
REGISTRATION_ENABLED=false
# Modo demonstracao: botao "Entrar como visitante" numa familia ficticia, recriada todo dia as 4h (Brasilia)
DEMO_MODE=false

# Webhook do Open Finance: vazio = nenhum webhook e aceito (a integracao e simulada)
OPENFINANCE_WEBHOOK_SECRET=

# IA nos comprovantes: desligada por padrao, a imagem sai do servidor para o provedor
CONTROLEI_AI_ENABLED=false
CONTROLEI_AI_API_KEY=
CONTROLEI_AI_MODEL=google/gemini-2.5-flash
CONTROLEI_AI_DAILY_LIMIT=30

# So para o override docker-compose.tailnet.yml: o IP da VPS na Tailscale (tailscale ip -4)
TAILSCALE_IP=
